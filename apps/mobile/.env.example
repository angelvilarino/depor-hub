# En desarrollo, deja la URL vacía: `npm run mobile` sirve `data/public` en el puerto 8000.
# Para apuntar a los datos publicados, pon la URL completa (sin barra final):
# EXPO_PUBLIC_DATA_BASE_URL=https://angelvilarino.github.io/depor-hub/v1
EXPO_PUBLIC_DATA_BASE_URL=
# Proxy de solo lectura para el marcador en directo (opcional; ver workers/live-proxy).
# Sin esta variable la app usa solo los datos estáticos publicados.
EXPO_PUBLIC_LIVE_BASE_URL=
# Puerto del servidor local de datos (opcional).
EXPO_PUBLIC_DATA_PORT=8000
