{
  "expo": {
    "name": "Depor Hub",
    "slug": "depor-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deporhub.app",
      "buildNumber": "1",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deporhub.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "deporhub",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Depor Hub añade los partidos que tú elijas a tu calendario.",
          "remindersPermission": false
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69d22d01-8a14-4773-9328-8ae9213e9ef1"
      }
    },
    "owner": "vilaa_7"
  }
}
