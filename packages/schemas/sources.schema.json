{
  "$defs": {
    "NewsSource": {
      "additionalProperties": false,
      "description": "Fuente p\u00fablica para filtros y cr\u00e9ditos (sources.json).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "items": {
          "default": 0,
          "minimum": 0,
          "title": "Items",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "club",
            "local",
            "nacional",
            "radio",
            "agregador",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "NewsSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataHash": {
      "default": "",
      "title": "Datahash",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/NewsSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "updatedAt": {
      "title": "Updatedat",
      "type": "string"
    }
  },
  "required": [
    "updatedAt",
    "sources"
  ],
  "title": "NewsSources",
  "type": "object"
}
