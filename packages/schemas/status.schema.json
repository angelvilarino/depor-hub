        "present"
      ],
      "title": "StatusFile",
      "type": "object"
    },
    "StatusWorkflow": {
      "additionalProperties": false,
      "description": "\u00daltima ejecuci\u00f3n completada de un workflow de datos.\n\nCada workflow tiene su propia ventana: Rivals es semanal y no puede quedar\nen rojo solo porque no aparece entre los 50 runs globales (PIPE-05). La\nantig\u00fcedad se mide desde el \u00faltimo \u00e9xito, no desde el \u00faltimo intento.",
      "properties": {
        "conclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conclusion"
        },
        "expectedWithinHours": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedwithinhours"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "lastSuccessAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastsuccessat"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "stale": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updatedat"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "file"
      ],
      "title": "StatusWorkflow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Diagn\u00f3stico operativo publicado en la rama `status` (ADR 0027).\n\nNo sustituye a `meta.json` ni a `news.json`: solo dice qu\u00e9 se public\u00f3, cu\u00e1ndo\ny c\u00f3mo termin\u00f3 la \u00faltima pasada de cada workflow. La app no depende de \u00e9l.",
  "properties": {
    "commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/StatusFile"
      },
      "title": "Files",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "updatedAt": {
      "title": "Updatedat",
      "type": "string"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/StatusWorkflow"
      },
      "title": "Workflows",
      "type": "array"
    }
  },
  "required": [
    "updatedAt",
    "ok"
  ],
  "title": "Status",
  "type": "object"
}
