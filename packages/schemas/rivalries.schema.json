        },
        "rival": {
          "title": "Rival",
          "type": "string"
        },
        "rivalBdfutbolId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rivalbdfutbolid"
        },
        "sinceYear": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sinceyear"
        }
      },
      "required": [
        "rival",
        "provenance"
      ],
      "title": "RivalryDetail",
      "type": "object"
    },
    "RivalryFact": {
