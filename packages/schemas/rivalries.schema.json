      "title": "Provenance",
      "type": "object"
    },
    "RivalryDetail": {
      "additionalProperties": false,
      "description": "Rivalidad con narrativa, cruces ic\u00f3nicos y balance hist\u00f3rico opcional.\n\nNo sustituye a `Club.rivalries`; lo ampl\u00eda en un fichero opcional. El balance\nlo rellena el pipeline desde BDFutbol y conserva su propia fuente.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/RivalryFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "headToHead": {
          "anyOf": [
