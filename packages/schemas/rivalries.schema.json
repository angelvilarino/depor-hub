{
  "$defs": {
    "HeadToHead": {
      "additionalProperties": false,
      "description": "Balance hist\u00f3rico completo y los \u00faltimos cinco cruces (BDFutbol).",
      "properties": {
        "confidence": {
          "default": "single_source",
          "enum": [
            "verified",
            "cross_checked",
            "single_source",
            "estimated"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "drawn": {
          "minimum": 0,
          "title": "Drawn",
          "type": "integer"
        },
        "goalsAgainst": {
          "minimum": 0,
          "title": "Goalsagainst",
          "type": "integer"
        },
        "goalsFor": {
          "minimum": 0,
          "title": "Goalsfor",
          "type": "integer"
        },
        "lost": {
          "minimum": 0,
          "title": "Lost",
          "type": "integer"
        },
        "meetings": {
          "items": {
            "$ref": "#/$defs/HeadToHeadMeeting"
          },
          "title": "Meetings",
          "type": "array"
        },
        "played": {
          "minimum": 0,
          "title": "Played",
          "type": "integer"
        },
        "scope": {
          "const": "all_official_matches",
          "default": "all_official_matches",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "default": "BDFutbol",
          "title": "Source",
          "type": "string"
        },
        "sourceUrl": {
          "title": "Sourceurl",
          "type": "string"
        },
        "won": {
          "minimum": 0,
          "title": "Won",
          "type": "integer"
        }
      },
      "required": [
        "sourceUrl",
        "played",
        "won",
        "drawn",
        "lost",
        "goalsFor",
        "goalsAgainst"
      ],
      "title": "HeadToHead",
      "type": "object"
    },
    "HeadToHeadMeeting": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "title": "Away",
          "type": "string"
        },
        "awayGoals": {
          "minimum": 0,
          "title": "Awaygoals",
          "type": "integer"
        },
        "competition": {
          "title": "Competition",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "deporResult": {
          "enum": [
            "W",
            "D",
            "L"
          ],
          "title": "Deporresult",
          "type": "string"
        },
        "home": {
          "title": "Home",
          "type": "string"
        },
        "homeGoals": {
          "minimum": 0,
          "title": "Homegoals",
          "type": "integer"
        },
        "round": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        }
      },
      "required": [
        "date",
        "competition",
        "home",
        "away",
        "homeGoals",
        "awayGoals",
        "deporResult"
      ],
      "title": "HeadToHeadMeeting",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "description": "Referencia a un medio externo con su licencia y atribuci\u00f3n.\n\nRegla del proyecto: las im\u00e1genes nuevas no se copian al repositorio. Se\npublica la URL original, el cr\u00e9dito y la licencia; si no hay licencia de\nreutilizaci\u00f3n, se dice expl\u00edcitamente. `verifiedAt` es la fecha en la que se\ncomprob\u00f3 que la URL segu\u00eda viva, no la fecha del dato deportivo.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "credit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credit"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "kind": {
          "default": "photo",
          "enum": [
            "photo",
            "video",
            "audio",
            "document"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "licenseUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licenseurl"
        },
        "origin": {
          "default": "other",
          "enum": [
            "commons",
            "club_official",
            "press",
            "other"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceurl"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifiedat"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "url"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "De d\u00f3nde sale un dato y con qu\u00e9 confianza (ADR 0008).",
      "properties": {
        "capturedAt": {
          "anyOf": [
            {
              "type": "string"
